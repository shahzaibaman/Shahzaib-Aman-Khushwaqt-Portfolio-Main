# Environment variables for Shahzaib's Portfolio
# Copy this file to .env and fill in the values.

# ── Optional: AI Chatbot LLM Proxy ──────────────────────────────────────────
# If set, the chatbot will call this URL (POST) as Layer B for questions
# not answered by the local keyword engine.
# The server should read GEMINI_API_KEY (or OPENAI_API_KEY) from its own env
# and NEVER expose it to the front end.
#
# Expected request body:  { "question": "..." }
# Expected response body: { "answer": "..." }
#
VITE_CHATBOT_API_URL=
